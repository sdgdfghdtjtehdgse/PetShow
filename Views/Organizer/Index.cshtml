@model IEnumerable<PetShow.Models.Show>
@{ ViewData["Title"] = "Панель организатора"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="ps-section-title mb-0">
                <i class="bi bi-calendar2-plus text-info me-2"></i>Панель для организатора выставок
            </h2>
            <p class="text-muted small mt-1">
                Управляйте выставками, которые вы организуете!
            </p>
        </div>
        <a asp-controller="Organizer" asp-action="CreateShow" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Новая выставка
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="ps-card p-5 text-center text-muted">
            <i class="bi bi-calendar-x fs-1 mb-3 d-block"></i>
            @if (User.IsInRole("Admin"))
            {
                <p>Выставок пока нет...</p>
            }
            else
            {
                <p>Вы ещё не создали ни одной выставки!</p>
            }
            <div class="mt-3">
                <a asp-controller="Organizer" asp-action="CreateShow" class="btn btn-primary">
                    Создать первую выставку
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="ps-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Тема</th>
                            <th>Место проведения</th>
                            <th>Дата</th>
                            <th>Участники</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Title</td>
                                <td><span class="ps-tag">@s.Theme</span></td>
                                <td class="text-muted small">@s.Venue.Name, @s.Venue.City</td>
                                <td class="text-muted small">@s.StartDate.ToString("dd MMM yyyy")</td>
                                <td class="text-muted small">@s.Bookings.Count / @s.MaxParticipants</td>
                                <td>
                                    @if (s.IsActive)
                                    { <span class="badge bg-success">Активна</span> }
                                    else
                                    { <span class="badge bg-secondary">Неактивна</span> }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-controller="Show" asp-action="Detail"
                                           asp-route-id="@s.Id"
                                           class="btn btn-outline-secondary btn-sm"
                                           title="Публичная страница">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Organizer" asp-action="EditShow"
                                           asp-route-id="@s.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post"
                                              asp-controller="Organizer"
                                              asp-action="DeleteShow"
                                              asp-route-id="@s.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Удалить выставку @s.Title?')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>