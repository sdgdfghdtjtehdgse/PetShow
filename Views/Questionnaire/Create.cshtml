@model PetShow.Models.ShowQuestionnaire
@{
    ViewData["Title"] = "Анкета участника";
    var show = ViewBag.Show as PetShow.Models.Show;
}

<div class="container my-5" style="max-width:640px;">
    <a asp-controller="Show" asp-action="Detail" asp-route-id="@show!.Id"
       class="btn btn-outline-secondary btn-sm mb-4">
        <i class="bi bi-arrow-left me-1"></i>Назад к выставке
    </a>

    <div class="ps-card p-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-clipboard-check text-primary me-2"></i>Анкета участника
        </h2>
        <p class="text-muted mb-4">
            Заполните анкету для участия в <strong>@show.Title</strong>.
            Это поможет организаторам подготовиться к приезду вашего питомца.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (ViewBag.ValidationErrors != null)
        {
            <div class="alert alert-danger">
                <ul class="mb-0 ps-3">
                    @foreach (var err in (List<string>)ViewBag.ValidationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ShowId" />

            <h6 class="fw-semibold text-primary mb-3">Информация о питомце</h6>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label asp-for="PetName" class="form-label fw-semibold">Кличка</label>
                    <input asp-for="PetName" class="form-control" placeholder="например, Барсик" required />
                    <span asp-validation-for="PetName" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PetAge" class="form-label fw-semibold">Возраст (лет)</label>
                    <input asp-for="PetAge" type="number" min="0" max="30"
                           class="form-control" required />
                    <span asp-validation-for="PetAge" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PetSpecies" class="form-label fw-semibold">Вид</label>
                    <input asp-for="PetSpecies" class="form-control" placeholder="например, Кошка" required />
                    <span asp-validation-for="PetSpecies" class="text-danger small"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PetBreed" class="form-label fw-semibold">Порода</label>
                    <input asp-for="PetBreed" class="form-control" placeholder="например, Сибирская" required />
                    <span asp-validation-for="PetBreed" class="text-danger small"></span>
                </div>
            </div>

            <hr />
            <h6 class="fw-semibold text-primary mb-3">Здоровье и особые требования</h6>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="IsVaccinated" class="form-check-input" type="checkbox" />
                    <label asp-for="IsVaccinated" class="form-check-label fw-semibold">
                        Питомец полностью вакцинирован?
                    </label>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="HasSpecialNeeds" class="form-check-input" type="checkbox"
                           id="specialNeedsToggle" />
                    <label asp-for="HasSpecialNeeds" class="form-check-label fw-semibold">
                        Есть особые потребности?
                    </label>
                </div>
            </div>

            <div class="mb-3" id="specialNeedsDetails" style="display:none;">
                <label asp-for="SpecialNeedsDetails" class="form-label fw-semibold">
                    Опишите особые потребности
                </label>
                <textarea asp-for="SpecialNeedsDetails" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="AdditionalInfo" class="form-label fw-semibold">
                    Дополнительная информация <span class="text-muted fw-normal">(необязательно)</span>
                </label>
                <textarea asp-for="AdditionalInfo" class="form-control" rows="3"
                          placeholder="Что ещё важно знать организаторам..."></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-send me-1"></i>Отправить анкету
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const toggle = document.getElementById('specialNeedsToggle');
        const details = document.getElementById('specialNeedsDetails');
        toggle.addEventListener('change', () => {
            details.style.display = toggle.checked ? 'block' : 'none';
        });
    </script>
}