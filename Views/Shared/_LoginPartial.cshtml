@using Microsoft.AspNetCore.Identity
@using PetShow.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <form method="post" asp-area="Identity" asp-page="/Account/Logout"
          asp-route-returnUrl="/">
        @Html.AntiForgeryToken()
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" asp-controller="Profile" asp-action="Index">
                    Привет, @UserManager.GetUserName(User)!
                </a>
            </li>
            <li class="nav-item">
                <button type="submit" class="btn btn-link nav-link">Выйти</button>
            </li>
        </ul>
    </form>
}
else
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Войти</a>
        </li>
    </ul>
}