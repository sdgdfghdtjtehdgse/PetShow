<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – PetShow</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- ── Навигация ──────────────────────────────────────────────────────── -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                <i class="bi bi-award-fill me-1"></i>PetShow
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Show" asp-action="Index">
                            <i class="bi bi-calendar-event me-1"></i>Выставки
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Rankings" asp-action="Index">
                            <i class="bi bi-trophy me-1"></i>Рейтинги
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Community" asp-action="Index">
                            <i class="bi bi-people me-1"></i>Форум
                        </a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Админ
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info" asp-controller="Organizer" asp-action="Index">
                                    <i class="bi bi-calendar2-plus me-1"></i>Организатор
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <form method="post" asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="/">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link">
                                    <i class="bi bi-box-arrow-right me-1"></i>Выйти
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm ms-2"
                               asp-area="Identity" asp-page="/Account/Register">
                                Регистрация
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ── Основной контент ───────────────────────────────────────────────── -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- ── Подвал ─────────────────────────────────────────────────────────── -->
    <footer class="bg-white border-top py-4 mt-4">
        <div class="container text-center text-muted small">
            <i class="bi bi-award-fill text-primary me-1"></i>
            <strong>PetShow</strong> &copy; @DateTime.Now.Year — Создан для курсового проекта (2026, 2ПР23)
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>