@model IEnumerable<PetShow.Models.Ranking>
@{ ViewData["Title"] = "Админ — Рейтинги"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="ps-section-title mb-0">
            <i class="bi bi-trophy text-warning me-2"></i>Рейтинги
        </h2>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="CreateRanking" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Добавить запись
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Панель
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ps-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th><th>Питомец</th><th>Выставка</th>
                        <th>Категория</th><th>Награда</th><th>Дата</th><th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                @if (r.Position == 1)     { <text>🥇</text> }
                                else if (r.Position == 2) { <text>🥈</text> }
                                else if (r.Position == 3) { <text>🥉</text> }
                                else { <span>@r.Position</span> }
                            </td>
                            <td class="fw-semibold">@r.Pet.Name</td>
                            <td class="small text-muted">@r.Show.Title</td>
                            <td><span class="ps-tag">@r.Category</span></td>
                            <td>@r.AwardTitle</td>
                            <td class="text-muted small">@r.AwardedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <form method="post"
                                      asp-controller="Admin"
                                      asp-action="DeleteRanking"
                                      asp-route-id="@r.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Удалить этот рейтинг?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>