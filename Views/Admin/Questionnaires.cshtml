@model IEnumerable<PetShow.Models.ShowQuestionnaire>
@{ ViewData["Title"] = "Админ — Анкеты"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="ps-section-title mb-0">
            <i class="bi bi-clipboard-check text-primary me-2"></i>Анкеты участников
        </h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Панель
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ps-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Пользователь</th><th>Выставка</th><th>Питомец</th>
                        <th>Вид</th><th>Вакцинация</th><th>Особые нужды</th>
                        <th>Дата</th><th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td>@q.User.FullName</td>
                            <td class="small">@q.Show.Title</td>
                            <td class="fw-semibold">@q.PetName</td>
                            <td class="text-muted small">@q.PetSpecies, @q.PetBreed</td>
                            <td>
                                @if (q.IsVaccinated)
                                { <span class="badge bg-success">Да</span> }
                                else
                                { <span class="badge bg-danger">Нет</span> }
                            </td>
                            <td>
                                @if (q.HasSpecialNeeds)
                                { <span class="badge bg-warning text-dark" title="@q.SpecialNeedsDetails">Да</span> }
                                else
                                { <span class="text-muted small">Нет</span> }
                            </td>
                            <td class="text-muted small">@q.SubmittedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <form method="post"
                                      asp-controller="Admin"
                                      asp-action="DeleteQuestionnaire"
                                      asp-route-id="@q.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            onclick="return confirm('Удалить эту анкету?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>