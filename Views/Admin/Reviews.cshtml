@model IEnumerable<PetShow.Models.Review>
@{ ViewData["Title"] = "Админ — Отзывы"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="ps-section-title mb-0">
            <i class="bi bi-star text-warning me-2"></i>Отзывы о местах проведения
        </h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Панель
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    @if (!Model.Any())
    {
    <div class="ps-card p-5 text-center text-muted">
        <i class="bi bi-star fs-1 mb-3 d-block text-warning"></i>
        Отзывов пока нет.
    </div>
    }
    else
    {
    <div class="ps-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th>Автор</th>
                    <th>Место проведения</th>
                    <th>Оценка</th>
                    <th>Заголовок</th>
                    <th>Текст</th>
                    <th>Дата</th>
                    <th>Действия</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                <tr>
                    <td class="fw-semibold small">@r.User.FullName</td>
                    <td class="text-muted small">@r.Venue.Name</td>
                    <td>
                                    <span class="ps-stars">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                        <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star") small"></i>
                                        }
                                    </span>
                    </td>
                    <td class="small fw-semibold">@r.Title</td>
                    <td class="text-muted small"
                        style="max-width:220px;white-space:nowrap;
                                           overflow:hidden;text-overflow:ellipsis;">
                        @r.Body
                    </td>
                    <td class="text-muted small">
                        @r.CreatedAt.ToString("dd MMM yyyy")
                    </td>
                    <td>
                        <form method="post"
                              asp-controller="Admin"
                              asp-action="DeleteReview"
                              asp-route-id="@r.Id">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    onclick="return confirm('Удалить этот отзыв?')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <p class="text-muted small mt-3">
        Всего: <strong>@Model.Count()</strong>
        отзыв@(Model.Count() == 1 ? "" : Model.Count() is >= 2 and <= 4 ? "а" : "ов").
    </p>
    }
</div>