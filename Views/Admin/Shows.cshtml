@model IEnumerable<PetShow.Models.Show>
@{ ViewData["Title"] = "Админ — Выставки"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="ps-section-title mb-0">
            <i class="bi bi-calendar-event text-primary me-2"></i>Выставки
        </h2>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="CreateShow" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Добавить выставку
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>Панель
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ps-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Название</th><th>Тема</th><th>Место проведения</th>
                        <th>Дата</th><th>Статус</th><th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Title</td>
                            <td><span class="ps-tag">@s.Theme</span></td>
                            <td class="text-muted small">@s.Venue.Name, @s.Venue.City</td>
                            <td class="text-muted small">@s.StartDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (s.IsActive)
                                { <span class="badge bg-success">Активна</span> }
                                else
                                { <span class="badge bg-secondary">Неактивна</span> }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-controller="Admin" asp-action="EditShow"
                                       asp-route-id="@s.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" asp-controller="Admin"
                                          asp-action="DeleteShow" asp-route-id="@s.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Удалить эту выставку?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>