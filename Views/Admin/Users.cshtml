@model IEnumerable<PetShow.Models.ApplicationUser>
@{
    ViewData["Title"] = "Админ — Пользователи";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="ps-section-title mb-0">
            <i class="bi bi-people text-primary me-2"></i>Пользователи
        </h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Панель
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ps-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Имя</th><th>Email</th><th>Роль</th>
                        <th>Дата регистрации</th><th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var roles = userRoles!.ContainsKey(u.Id) ? userRoles[u.Id] : new List<string>();
                        var isAdmin = roles.Contains("Admin");
                        var isOrganizer = roles.Contains("Organizer");
                        <tr>
                            <td class="fw-semibold">@u.FullName</td>
                            <td class="text-muted small">@u.Email</td>
                            <td>
                                @if (isAdmin)
                                { <span class="badge bg-danger me-1">Администратор</span> }
                                @if (isOrganizer)
                                { <span class="badge bg-info text-dark me-1">Организатор</span> }
                                @if (!isAdmin && !isOrganizer)
                                { <span class="badge bg-secondary">Пользователь</span> }
                            </td>
                            <td class="text-muted small">@u.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="ToggleAdminRole"
                                          asp-route-userId="@u.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm @(isAdmin ? "btn-outline-warning" : "btn-outline-danger")"
                                                onclick="return confirm('@(isAdmin ? "Снять права администратора?" : "Назначить администратором?")')">
                                            @(isAdmin ? "Снять админа" : "Назначить админом")
                                        </button>
                                    </form>
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="ToggleOrganizerRole"
                                          asp-route-userId="@u.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm @(isOrganizer ? "btn-outline-secondary" : "btn-outline-info")"
                                                onclick="return confirm('@(isOrganizer ? "Снять роль организатора?" : "Назначить организатором?")')">
                                            @(isOrganizer ? "Снять организатора" : "Назначить организатором")
                                        </button>
                                    </form>
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="DeleteUser"
                                          asp-route-userId="@u.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Удалить этого пользователя?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>