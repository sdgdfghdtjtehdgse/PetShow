@model IEnumerable<PetShow.Models.Pet>
@{ ViewData["Title"] = "Админ — Питомцы"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="ps-section-title mb-0">
            <i class="bi bi-heart text-danger me-2"></i>Питомцы
        </h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Панель
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="ps-card p-5 text-center text-muted">
            <i class="bi bi-heart fs-1 mb-3 d-block text-danger"></i>
            Питомцев пока нет в системе.
        </div>
    }
    else
    {
        <div class="ps-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Фото</th><th>Кличка</th><th>Вид</th><th>Порода</th>
                            <th>Возраст</th><th>Владелец</th><th>Добавлен</th><th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pet in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(pet.PhotoUrl))
                                    {
                                        <img src="@pet.PhotoUrl" alt="@pet.Name"
                                             class="rounded-circle"
                                             style="width:40px;height:40px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-light d-flex align-items-center
                                                    justify-content-center"
                                             style="width:40px;height:40px;">
                                            <i class="bi bi-heart-fill text-muted small"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-semibold">@pet.Name</td>
                                <td><span class="ps-tag">@pet.Species</span></td>
                                <td class="text-muted small">@pet.Breed</td>
                                <td class="text-muted small">@pet.Age л.</td>
                                <td>
                                    <div class="small">
                                        <div class="fw-semibold">@pet.Owner.FullName</div>
                                        <div class="text-muted">@pet.Owner.Email</div>
                                    </div>
                                </td>
                                <td class="text-muted small">@pet.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <form method="post"
                                          asp-controller="Admin"
                                          asp-action="DeletePet"
                                          asp-route-id="@pet.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                onclick="return confirm('Удалить @pet.Name из системы?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <p class="text-muted small mt-3">
            Всего: <strong>@Model.Count()</strong> питомц@(Model.Count() == 1 ? "ец" : Model.Count() is >= 2 and <= 4 ? "а" : "ев") в системе.
        </p>
    }
</div>