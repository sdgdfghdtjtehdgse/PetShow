@model IEnumerable<PetShow.Models.Booking>
@{
    ViewData["Title"] = "Мои записи";
}

<div class="container my-5">
    <h2 class="ps-section-title">
        <i class="bi bi-ticket-perforated text-primary me-2"></i>Мои записи
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="ps-card p-5 text-center text-muted">
            <i class="bi bi-calendar-x fs-1 mb-3 d-block"></i>
            У вас пока нет записей на выставки.
            <div class="mt-3">
                <a asp-controller="Show" asp-action="Index" class="btn btn-primary">
                    Смотреть выставки
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var b in Model)
            {
                <div class="col-md-6">
                    <div class="ps-card p-4 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">@b.Show.Title</h5>
                            <span class="badge rounded-pill
                                @(b.Status == PetShow.Models.BookingStatus.Confirmed ? "bg-success" :
                                  b.Status == PetShow.Models.BookingStatus.Pending   ? "bg-warning text-dark" :
                                  "bg-secondary")">
                                @(b.Status == PetShow.Models.BookingStatus.Confirmed ? "Подтверждено" :
                                  b.Status == PetShow.Models.BookingStatus.Pending   ? "Ожидание" :
                                  "Отменено")
                            </span>
                        </div>

                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt me-1"></i>@b.Show.Venue.Name, @b.Show.Venue.City
                        </p>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-calendar me-1"></i>
                            @b.Show.StartDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-heart me-1"></i>Питомец: <strong>@b.Pet.Name</strong>
                            (@b.Pet.Species)
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-clock me-1"></i>Записан: @b.BookedAt.ToString("dd MMM yyyy")
                        </p>

                        @if (!string.IsNullOrEmpty(b.Notes))
                        {
                            <p class="small fst-italic text-muted border-start border-3 ps-2 mb-3">
                                "@b.Notes"
                            </p>
                        }

                        @if (b.Status != PetShow.Models.BookingStatus.Cancelled)
                        {
                            <form method="post" asp-action="Cancel" asp-route-id="@b.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        onclick="return confirm('Отменить эту запись?')">
                                    <i class="bi bi-x-circle me-1"></i>Отменить запись
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>