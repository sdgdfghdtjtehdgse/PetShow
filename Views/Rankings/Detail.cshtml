@model PetShow.Models.Show
@using PetShow.Models
@{
    ViewData["Title"] = $"Рейтинг — {Model.Title}";
    var grouped = ViewBag.Grouped as Dictionary<string, List<Ranking>>;

    var top3 = Model.Rankings
        .Where(r => r.Position <= 3)
        .OrderBy(r => r.Position)
        .DistinctBy(r => r.Position)
        .Take(3)
        .ToList();

    var first  = top3.FirstOrDefault(r => r.Position == 1);
    var second = top3.FirstOrDefault(r => r.Position == 2);
    var third  = top3.FirstOrDefault(r => r.Position == 3);
}

<div class="container my-5">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-4">
        <i class="bi bi-arrow-left me-1"></i>Назад к рейтингам
    </a>

    <!-- Заголовок выставки -->
    <div class="ps-card p-4 mb-4">
        <div class="mb-2">
            <span class="ps-tag fs-6">@Model.Theme</span>
            <span class="ps-tag-accent ms-2">@Model.AllowedAnimals</span>
        </div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-trophy text-warning me-2"></i>@Model.Title
        </h2>
        <p class="text-muted small mb-0">
            <i class="bi bi-geo-alt me-1"></i>@Model.Venue.Name, @Model.Venue.City
            &nbsp;·&nbsp;
            <i class="bi bi-calendar me-1"></i>@Model.StartDate.ToString("dd MMMM yyyy")
        </p>
    </div>

    @if (grouped == null || !grouped.Any())
    {
        <div class="alert alert-info">Рейтинги для этой выставки ещё не опубликованы.</div>
    }
    else
    {
        <!-- Подиум топ-3 -->
        @if (top3.Any())
        {
            <div class="ps-card p-4 mb-4 text-center">
                <h5 class="fw-bold mb-4">🏆 Доска почета!</h5>
                <div class="d-flex justify-content-center align-items-end gap-4">

                    <!-- 2-е место -->
                    @if (second != null)
                    {
                        <div class="text-center">
                            @if (!string.IsNullOrEmpty(second.Pet.PhotoUrl))
                            {
                                <img src="@second.Pet.PhotoUrl" alt="@second.Pet.Name"
                                     class="rounded-circle mb-2 border border-3"
                                     style="width:70px;height:70px;object-fit:cover;
                                            border-color:#C0C0C0!important;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center
                                            justify-content-center mx-auto mb-2 border border-3"
                                     style="width:70px;height:70px;border-color:#C0C0C0!important;">
                                    <i class="bi bi-heart-fill text-muted fs-4"></i>
                                </div>
                            }
                            <div class="fw-bold">@second.Pet.Name</div>
                            <div class="text-muted small">@second.Pet.Breed</div>
                            <div class="fs-2 mt-1">🥈</div>
                            <div class="bg-secondary bg-opacity-25 rounded-bottom px-3 py-2 mt-1"
                                 style="height:80px;">
                                <span class="small text-muted">@second.Category</span>
                            </div>
                        </div>
                    }

                    <!-- 1-е место -->
                    @if (first != null)
                    {
                        <div class="text-center">
                            @if (!string.IsNullOrEmpty(first.Pet.PhotoUrl))
                            {
                                <img src="@first.Pet.PhotoUrl" alt="@first.Pet.Name"
                                     class="rounded-circle mb-2 border border-3"
                                     style="width:90px;height:90px;object-fit:cover;
                                            border-color:#FFD700!important;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center
                                            justify-content-center mx-auto mb-2 border border-3"
                                     style="width:90px;height:90px;border-color:#FFD700!important;">
                                    <i class="bi bi-heart-fill text-warning fs-3"></i>
                                </div>
                            }
                            <div class="fw-bold fs-5">@first.Pet.Name</div>
                            <div class="text-muted small">@first.Pet.Breed</div>
                            <div class="fs-1 mt-1">🥇</div>
                            <div class="bg-warning bg-opacity-25 rounded-bottom px-3 py-2 mt-1"
                                 style="height:100px;">
                                <span class="small text-muted">@first.Category</span>
                                @if (!string.IsNullOrEmpty(first.AwardTitle))
                                {
                                    <div class="fw-semibold small text-warning">@first.AwardTitle</div>
                                }
                            </div>
                        </div>
                    }

                    <!-- 3-е место -->
                    @if (third != null)
                    {
                        <div class="text-center">
                            @if (!string.IsNullOrEmpty(third.Pet.PhotoUrl))
                            {
                                <img src="@third.Pet.PhotoUrl" alt="@third.Pet.Name"
                                     class="rounded-circle mb-2 border border-3"
                                     style="width:70px;height:70px;object-fit:cover;
                                            border-color:#CD7F32!important;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center
                                            justify-content-center mx-auto mb-2 border border-3"
                                     style="width:70px;height:70px;border-color:#CD7F32!important;">
                                    <i class="bi bi-heart-fill text-muted fs-4"></i>
                                </div>
                            }
                            <div class="fw-bold">@third.Pet.Name</div>
                            <div class="text-muted small">@third.Pet.Breed</div>
                            <div class="fs-2 mt-1">🥉</div>
                            <div class="bg-secondary bg-opacity-10 rounded-bottom px-3 py-2 mt-1"
                                 style="height:60px;">
                                <span class="small text-muted">@third.Category</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Рейтинги по категориям -->
        <h4 class="ps-section-title">Результаты по категориям</h4>
        <div class="row g-4">
            @foreach (var category in grouped)
            {
                <div class="col-md-6">
                    <div class="ps-card p-4 h-100">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-tag me-1"></i>@category.Key
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle small mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th>Питомец</th>
                                        <th>Порода</th>
                                        <th>Владелец</th>
                                        <th>Награда</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in category.Value)
                                    {
                                        <tr>
                                            <td>
                                                @if (r.Position == 1)     { <text>🥇</text> }
                                                else if (r.Position == 2) { <text>🥈</text> }
                                                else if (r.Position == 3) { <text>🥉</text> }
                                                else { <span class="text-muted">@r.Position</span> }
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    @if (!string.IsNullOrEmpty(r.Pet.PhotoUrl))
                                                    {
                                                        <img src="@r.Pet.PhotoUrl"
                                                             class="rounded-circle"
                                                             style="width:32px;height:32px;object-fit:cover;"
                                                             alt="@r.Pet.Name" />
                                                    }
                                                    <span class="fw-semibold">@r.Pet.Name</span>
                                                </div>
                                            </td>
                                            <td class="text-muted">@r.Pet.Breed</td>
                                            <td class="text-muted">@r.Pet.Owner.FullName</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(r.AwardTitle))
                                                {
                                                    <span class="ps-tag-accent">@r.AwardTitle</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>