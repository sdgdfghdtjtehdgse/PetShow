@model IEnumerable<PetShow.Models.Show>
@{
    ViewData["Title"] = "Рейтинги";
}

<div class="container my-5">
    <h2 class="ps-section-title">
        <i class="bi bi-trophy text-warning me-2"></i>Рейтинги выставок
    </h2>
    <p class="text-muted mb-4">Просмотрите таблицы лидеров прошедших и текущих выставок!</p>

    @if (!Model.Any())
    {
        <div class="ps-card p-5 text-center text-muted">
            <i class="bi bi-trophy fs-1 mb-3 d-block text-warning"></i>
            Рейтинги пока не опубликованы. Загляните сюда после первой выставки!
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var show in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="ps-card p-4 h-100">
                        <div class="mb-2">
                            <span class="ps-tag">@show.Theme</span>
                        </div>
                        <h5 class="fw-bold mb-1">@show.Title</h5>
                        <p class="text-muted small mb-1">
                            <i class="bi bi-geo-alt me-1"></i>@show.Venue.City
                        </p>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-calendar me-1"></i>
                            @show.StartDate.ToString("dd MMM yyyy")
                        </p>

                        <!-- Топ-3 -->
                        <div class="mb-3">
                            @foreach (var r in show.Rankings.OrderBy(r => r.Position).Take(3))
                            {
                                if (r.Pet == null) { continue; }
                                <div class="d-flex align-items-center gap-2 mb-1 small">
                                    <span>
                                        @if (r.Position == 1)     { <text>🥇</text> }
                                        else if (r.Position == 2) { <text>🥈</text> }
                                        else                      { <text>🥉</text> }
                                    </span>
                                    <span class="fw-semibold">@r.Pet.Name</span>
                                    <span class="text-muted">— @r.Category</span>
                                </div>
                            }
                        </div>

                        <a asp-action="Detail" asp-route-id="@show.Id"
                           class="btn btn-outline-primary btn-sm">
                            Полный рейтинг <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>